# ---- Guarantee types

sai:structural
    a owl:NamedIndividual ,
        sai:GuaranteeType ;
    rdfs:label "Structural"@en ;
    sai:rank "3"^^xsd:integer ;
    sai:meaning "Enforced in code or configuration. It cannot happen, whatever the AI does or is told."@en ;
    sai:example "A phone number is masked by the server before the AI ever receives it."@en ;
    sai:failsBy "Misconfiguration, or rules too narrow to catch what matters."@en .

sai:procedural
    a owl:NamedIndividual ,
        sai:GuaranteeType ;
    rdfs:label "Procedural"@en ;
    sai:rank "2"^^xsd:integer ;
    sai:meaning "It cannot happen without a named person's approval or a recorded process."@en ;
    sai:example "Write access stays off until an administrator signs a recorded decision to enable it."@en ;
    sai:failsBy "Rubber-stamping, approval fatigue, approvers who lack context."@en .

sai:guided
    a owl:NamedIndividual ,
        sai:GuaranteeType ;
    rdfs:label "Guided"@en ;
    sai:rank "1"^^xsd:integer ;
    sai:meaning "The AI or its users are told what to do and usually comply. Nothing ensures it."@en ;
    sai:example "Staff are told not to paste personal data into a chatbot."@en ;
    sai:failsBy "Drift, misreading, prompt injection, model updates, forgetfulness."@en .

sai:none
    a owl:NamedIndividual ,
        sai:GuaranteeType ;
    rdfs:label "None"@en ;
    sai:rank "0"^^xsd:integer ;
    sai:meaning "No control exists yet."@en .

