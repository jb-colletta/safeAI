# ---- Levels

sai:L1
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 1: Data protection"@en ;
    skos:notation "L1" ;
    sai:number "1"^^xsd:integer ;
    sai:verb sai:SEE ;
    sai:tagline "Your people's data stays protected."@en ;
    sai:question "Can the AI see personal or sensitive information? Could it leak?"@en ;
    sai:harm "Exposure of personal, financial, health, case, or contact data; legal and reputational damage."@en .

sai:L2
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 2: Vendor and model trust"@en ;
    skos:notation "L2" ;
    sai:number "2"^^xsd:integer ;
    sai:verb sai:SEE ;
    sai:tagline "Your data is not used to train AI, and you control the account."@en ;
    sai:question "Which AI company and model? Do they keep or train on our data?"@en ;
    sai:harm "Constituent data retained or reused outside your control."@en .

sai:L3
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 3: Delegation and authority"@en ;
    skos:notation "L3" ;
    sai:number "3"^^xsd:integer ;
    sai:verb sai:DO ;
    sai:tagline "It does only what you grant, and it stops for a person."@en ;
    sai:question "Can it change records, spend money, or message people on its own?"@en ;
    sai:harm "Unauthorized changes, mass messages, and actions triggered by hidden instructions in documents."@en .

sai:L4
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 4: Protection of the vulnerable"@en ;
    skos:notation "L4" ;
    sai:number "4"^^xsd:integer ;
    sai:verb sai:DO ;
    sai:tagline "Children and people in crisis are protected by rules no setting can lower."@en ;
    sai:question "What about children, survivors, clients in crisis, and people who depend on us?"@en ;
    sai:harm "Harm to minors or vulnerable people; safeguarding failures; unfair decisions that the affected people cannot see or contest."@en .

sai:L5
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 5: Mission and values fidelity"@en ;
    skos:notation "L5" ;
    sai:number "5"^^xsd:integer ;
    sai:verb sai:SAY ;
    sai:tagline "It is held to what your organization stands for."@en ;
    sai:question "Will it say something that contradicts our mission, commitments, or facts?"@en ;
    sai:harm "Misstatements made in your name; erosion of the trust your mission depends on."@en .

sai:L6
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 6: The human boundary"@en ;
    skos:notation "L6" ;
    sai:number "6"^^xsd:integer ;
    sai:verb sai:SAY ;
    sai:tagline "It represents; it never impersonates or replaces a person."@en ;
    sai:question "Will it pretend to be a person, or stand in for someone whose role needs a human?"@en ;
    sai:harm "AI presented as a staff member or professional; care and judgment reduced to automation."@en .

sai:L7
    a owl:NamedIndividual ,
        sai:Level ;
    rdfs:label "Level 7: Accountability and governance"@en ;
    skos:notation "L7" ;
    sai:number "7"^^xsd:integer ;
    sai:verb sai:ANSWER ;
    sai:tagline "You set the rules, and you can see and stop every decision."@en ;
    sai:question "Who is responsible? Can we see what it did, and can we stop it?"@en ;
    sai:harm "Nobody can explain an action afterwards; the organization cannot show due care."@en .

# ---- Controls

sai:L1.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Data inventory and classification"@en ;
    skos:notation "L1.01" ;
    sai:level sai:L1 ;
    sai:question "Do you know which data the AI systems in scope can reach, and is that data classified by sensitivity?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. List every system the AI can read from or write to (databases, email, file shares, CRM, case systems)."@en ,
        "2. Classify the data in each as public, internal, confidential, or restricted."@en ,
        "3. Record the classification where the people configuring AI access will see it."@en ;
    sai:evidence "Data inventory or register"@en ,
        "Classification scheme"@en .

sai:L1.02
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "AI inherits the user's own permissions"@en ;
    skos:notation "L1.02" ;
    sai:level sai:L1 ;
    sai:question "Does the AI act with the signed-in person's own access rights, so it can never see more than that person can?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Connect AI tools through each person's own identity (for example OAuth or single sign-on), not a shared super-account."@en ,
        "2. Remove any shared service accounts with broad read access."@en ,
        "3. Test with a low-privilege user and confirm the AI cannot reach restricted data."@en ;
    sai:evidence "Integration configuration"@en ,
        "Result of a low-privilege access test"@en .

sai:L1.03
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Restricted data is blocked from AI paths by default"@en ;
    skos:notation "L1.03" ;
    sai:level sai:L1 ;
    sai:question "Are your most sensitive data sets (credentials, payment details, case files) technically unreachable by the AI unless someone deliberately opens them?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Maintain a block list of tables, folders, or fields the AI can never query."@en ,
        "2. Start the list with payment instruments, credentials, system configuration, and message content."@en ,
        "3. Make removing an item from the block list a recorded decision."@en ;
    sai:evidence "Block list configuration"@en ,
        "Change history for the block list"@en .

sai:L1.04
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Personal data is masked before it reaches the model"@en ;
    skos:notation "L1.04" ;
    sai:level sai:L1 ;
    sai:question "Are sensitive fields (email, phone, birth date, ID numbers, addresses) masked or removed in code before the AI receives them?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Put a masking layer between your data and the AI so masking cannot be bypassed with a clever prompt."@en ,
        "2. Define the list of masked fields and review it each quarter."@en ,
        "3. Verify with test records that real values never appear in what is sent to the model."@en ;
    sai:evidence "Masking rules"@en ,
        "Test results showing masked output"@en .

sai:L1.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Personal data inside free text is detected"@en ;
    skos:notation "L1.05" ;
    sai:level sai:L1 ;
    sai:question "Do you detect and mask personal data typed into notes, comments, or message fields, not only data in labeled fields?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Test whether a phone number or disclosure typed into a notes field reaches the AI unmasked."@en ,
        "2. Add pattern-based detection (and, where warranted, entity recognition) for free-text fields."@en ,
        "3. Where detection is imperfect, block free-text fields on the most sensitive records instead."@en ;
    sai:evidence "Free-text test cases and results"@en .

sai:L1.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Staff know what not to paste into AI tools"@en ;
    skos:notation "L1.06" ;
    sai:level sai:L1 ;
    sai:question "Do staff and volunteers have clear, short guidance on what data must never be typed or pasted into an AI tool?"@en ;
    sai:audience sai:audience-organization ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Write a one-page do and do-not list with concrete examples from your own work."@en ,
        "2. Include it in onboarding and repeat it at least yearly."@en ,
        "3. Be honest in your own reporting that this control is guided, not enforced."@en ;
    sai:evidence "The guidance document"@en ,
        "Training attendance"@en .

sai:L1.07
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Pass-through handling and minimal retention"@en ;
    skos:notation "L1.07" ;
    sai:level sai:L1 ;
    sai:question "Do your AI integrations avoid storing constituent records, and do they keep prompts, outputs, and logs only as long as needed?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Document what each AI integration stores, where, and for how long."@en ,
        "2. Set retention limits and automatic deletion for prompts, outputs, and caches."@en ,
        "3. Keep personal data out of logs, or mask it there as well."@en ;
    sai:evidence "Retention settings"@en ,
        "Data flow diagram"@en .

sai:L1.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Privacy obligations cover AI use"@en ;
    skos:notation "L1.08" ;
    sai:level sai:L1 ;
    sai:question "Do your privacy notice, consent practices, and (where required) impact assessments cover the use of AI with personal data?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Check which privacy laws and funder or regulator rules apply to you (verify with qualified legal advice)."@en ,
        "2. Update your privacy notice to describe AI processing in plain language."@en ,
        "3. Complete a data protection impact assessment where your jurisdiction requires or recommends one."@en ;
    sai:evidence "Updated privacy notice"@en ,
        "Impact assessment"@en .

sai:L2.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Vendor data terms reviewed"@en ;
    skos:notation "L2.01" ;
    sai:level sai:L2 ;
    sai:question "Have you read and recorded what each AI vendor does with your data: training, retention, human review, deletion?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. For every AI vendor, record whether your data is used for training and for how long it is retained."@en ,
        "2. Note which account type the answer depends on. Consumer and business terms often differ."@en ,
        "3. Re-check whenever the vendor updates its terms."@en ;
    sai:evidence "Vendor review record with date and the terms reviewed"@en .

sai:L2.02
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Organization-managed accounts, not personal logins"@en ;
    skos:notation "L2.02" ;
    sai:level sai:L2 ;
    sai:question "Do staff use AI through accounts your organization manages, so you control seats, settings, and offboarding?"@en ;
    sai:audience sai:audience-organization ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Provide approved AI tools on organization-managed accounts."@en ,
        "2. Use single sign-on where available, so removing a person removes their access."@en ,
        "3. Where you cannot technically block personal accounts, say plainly that this control is procedural or guided."@en ;
    sai:evidence "Account administration console"@en ,
        "Offboarding checklist"@en .

sai:L2.03
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Model and sub-processor inventory"@en ;
    skos:notation "L2.03" ;
    sai:level sai:L2 ;
    sai:question "Can you say which AI model and which companies process your data, and where?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Publish a one-page statement listing each model, vendor, sub-processor, and processing region."@en ,
        "2. Update it when you change model or vendor."@en ;
    sai:evidence "Model and sub-processor statement"@en .

sai:L2.04
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Contracts and data processing terms"@en ;
    skos:notation "L2.04" ;
    sai:level sai:L2 ;
    sai:question "Are there written agreements covering confidentiality, data processing, breach notification, and deletion on exit?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Confirm a data processing agreement or equivalent exists for each vendor handling personal data."@en ,
        "2. Check breach-notification timing and deletion-on-exit commitments."@en ,
        "3. Ask a lawyer or your funder's compliance contact to review anything unusual."@en ;
    sai:evidence "Signed agreements"@en .

sai:L2.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Vendor safety rules and values are known"@en ;
    skos:notation "L2.05" ;
    sai:level sai:L2 ;
    sai:question "Do you know which safety rules and published values the underlying model brings, and have you told your leadership?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Read the vendor's published usage policy and model documentation."@en ,
        "2. Tell leadership and, where relevant, constituents that your own rules sit on top of the vendor's, so nobody discovers a second, invisible value layer on their own."@en ;
    sai:evidence "Summary of vendor policies"@en ,
        "Leadership briefing"@en .

sai:L2.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Your own commitment on constituent data"@en ;
    skos:notation "L2.06" ;
    sai:level sai:L2 ;
    sai:question "Have you made, and published, a commitment about what you yourself do with constituent data in AI contexts (no selling, no training, no pooling without consent)?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Decide and write down what you will never do with constituent data, whatever a vendor permits."@en ,
        "2. Publish it in plain language where constituents and partners can find it."@en ,
        "3. Hold yourself to it through your governance process (see L7)."@en ;
    sai:evidence "Published data commitment"@en .

sai:L2.07
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Environmental and labor due diligence"@en ;
    skos:notation "L2.07" ;
    sai:level sai:L2 ;
    sai:question "Have you considered, and recorded, what the vendor discloses about energy and water use and the working conditions of the people who label data and moderate content?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Ask each vendor for its published environmental and labor disclosures."@en ,
        "2. Record what you found and how it informed your choice."@en ;
    sai:evidence "Vendor disclosures reviewed"@en .

sai:L2.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Re-assessment on vendor or model change"@en ;
    skos:notation "L2.08" ;
    sai:level sai:L2 ;
    sai:question "Do you re-run this assessment, and your behavioral tests, when a vendor changes its terms, or a model is swapped or updated?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Subscribe to vendor change notices."@en ,
        "2. Make a model or terms change a trigger in your change-control process (see L7.14)."@en ;
    sai:evidence "Change log showing re-assessment"@en .

sai:L3.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Allow-list of AI actions, deny by default"@en ;
    skos:notation "L3.01" ;
    sai:level sai:L3 ;
    sai:question "Is every action the AI can take (read, create, update, send, delete) explicitly granted per role, with everything else denied?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. List the action classes your AI integrations can perform."@en ,
        "2. Grant each explicitly to specific roles. Treat anything unlisted as denied."@en ,
        "3. Review grants at least twice a year."@en ;
    sai:evidence "Grant table"@en ,
        "Configuration showing deny-by-default"@en .

sai:L3.02
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Write and send capabilities are off until a decision is recorded"@en ;
    skos:notation "L3.02" ;
    sai:level sai:L3 ;
    sai:question "Is the ability to change records or send messages switched off by default, and turned on only through a recorded decision?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Start every deployment read-only."@en ,
        "2. Require a short written decision, with named approver and impact assessment (see L7.10), before enabling write or send."@en ;
    sai:evidence "Decision record for each enabled capability"@en .

sai:L3.03
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Draft versus commit"@en ;
    skos:notation "L3.03" ;
    sai:level sai:L3 ;
    sai:question "Can the AI draft or stage a change or message, with a person required to commit or send it, unless a grant says otherwise?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Split each write or send action into a staged step and a commit step."@en ,
        "2. Make the commit step a human action in the tool itself, not a convention."@en ,
        "3. Show approvers what will change, not only the AI's summary of it."@en ;
    sai:evidence "Workflow showing a human commit step"@en .

sai:L3.04
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "Irreversible actions are never autonomous"@en ;
    skos:notation "L3.04" ;
    sai:level sai:L3 ;
    sai:question "Do deletions, bulk messages, payments, and changes to protected records always need a human commit, whatever the grant?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "Serious or irreversible decisions stay with people."@en ;
    sai:step "1. Define irreversible: anything that cannot be fully undone or that reaches many people."@en ,
        "2. Enforce a human commit for those actions in code, regardless of role or grant."@en ,
        "3. Hold mass updates above a set threshold for approval."@en ;
    sai:evidence "Rule configuration"@en ,
        "Tests attempting each irreversible action"@en .

sai:L3.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Every grant has a named signer"@en ;
    skos:notation "L3.05" ;
    sai:level sai:L3 ;
    sai:question "For each thing the AI is allowed to do, is there a named person who signed off on that grant?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Record who authorized each grant, when, and under which policy version."@en ,
        "2. The signer is a person in a defined role, never the AI and never the vendor."@en ;
    sai:evidence "Grant records with signer and date"@en .

sai:L3.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Escalation is designed, not an error path"@en ;
    skos:notation "L3.06" ;
    sai:level sai:L3 ;
    sai:question "Is there a defined point at which the AI must stop and hand a decision to a person, with a record of what was asked and why it stopped?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Define the conditions that require a person: sensitive topics, uncertainty, conflict with a firm rule, high impact."@en ,
        "2. When a firm rule conflicts with an instruction, hold and surface the conflict to the requester. Never silently comply or silently refuse."@en ,
        "3. Record each handoff: the request, the proposed action, the rule, the risk."@en ;
    sai:evidence "Escalation rules"@en ,
        "Sample handoff records"@en .

sai:L3.07
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Prompt-injection containment"@en ;
    skos:notation "L3.07" ;
    sai:level sai:L3 ;
    sai:question "Is content from outside (uploads, inbound email, web pages, form submissions) treated as untrusted, with stricter limits on what the AI may do after reading it?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-high ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Tag any action proposed while the AI was reading external content with a provenance flag."@en ,
        "2. Apply stricter rules, or a mandatory human commit, to flagged actions."@en ,
        "3. Test with documents that contain hidden instructions (see L7.13)."@en ;
    sai:evidence "Provenance flag implementation"@en ,
        "Red-team results"@en .

sai:L3.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Volume and rate limits"@en ;
    skos:notation "L3.08" ;
    sai:level sai:L3 ;
    sai:question "Are there hard caps on recipients per message, records changed per run, and spend per period?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Set conservative defaults for recipients per send, records per update, and API or spend limits."@en ,
        "2. Raising a cap is a recorded decision."@en ;
    sai:evidence "Configured limits"@en .

sai:L3.09
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Policy travels with delegated work"@en ;
    skos:notation "L3.09" ;
    sai:level sai:L3 ;
    sai:question "When one AI agent or tool hands work to another, do your constraints travel with it?"@en ;
    sai:audience sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-high ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Pass the originating role, grant, and policy version with every sub-agent or tool call."@en ,
        "2. Reject calls that arrive without that context."@en ;
    sai:evidence "Architecture description"@en ,
        "Tests with stripped context"@en .

sai:L4.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Protected people and records are defined"@en ;
    skos:notation "L4.01" ;
    sai:level sai:L4 ;
    sai:question "Have you written down who counts as a protected person (minors, vulnerable adults, survivors, clients in crisis) and which records concern them?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Use your safeguarding policy, funder requirements, and applicable law to define the groups."@en ,
        "2. List the systems, tables, folders, and fields that hold their information."@en ,
        "3. Have your safeguarding lead review the list."@en ;
    sai:evidence "Protected persons definition"@en ,
        "Protected records list"@en .

sai:L4.02
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Protected records blocked or masked by default"@en ;
    skos:notation "L4.02" ;
    sai:level sai:L4 ;
    sai:question "Are safeguarding, case, counseling, health, and similar records blocked or masked from AI paths unless a named person has opened them?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Add the records from L4.01 to your block or mask list (see L1.03 and L1.04)."@en ,
        "2. Cover vulnerable adults with the same protections as minors."@en ;
    sai:evidence "Block list showing protected records"@en .

sai:L4.03
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "Images and identifying details of minors stay off AI paths"@en ;
    skos:notation "L4.03" ;
    sai:level sai:L4 ;
    sai:question "Are photos and identifying details of children unreachable by AI, and is AI generation or editing of images of identifiable children prohibited?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "Children's images and identifying details are kept off AI paths."@en ;
    sai:step "1. Exclude photo and file fields for minors from every AI integration."@en ,
        "2. Mask age group, grade, and guardian links by default."@en ,
        "3. Check which file and image tools your AI integrations expose, and disable the ones that reach these files."@en ;
    sai:evidence "File tool configuration"@en ,
        "Test results"@en .

sai:L4.04
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "No AI-initiated contact with minors without required adults"@en ;
    skos:notation "L4.04" ;
    sai:level sai:L4 ;
    sai:question "Is it impossible for the AI to send a message to a minor without a parent, guardian, or other required adult included, where your policy requires it?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "The AI does not contact children without the required adults."@en ;
    sai:step "1. Add a recipient rule on every send path that checks for minors and required copies."@en ,
        "2. Hold, and do not send, any message that fails the rule."@en ;
    sai:evidence "Recipient rule"@en ,
        "Test messages"@en .

sai:L4.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Abuse, self-harm, and crisis content goes to a person"@en ;
    skos:notation "L4.05" ;
    sai:level sai:L4 ;
    sai:question "Is content about abuse, self-harm, or immediate danger never auto-sent, and routed to a named person and your reporting workflow?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Identify the people and procedures that handle disclosures, and the reporting duties that apply to you (verify with your safeguarding lead and legal counsel)."@en ,
        "2. Route detected content to that person. Hold it instead of sending."@en ,
        "3. Test the route with seeded examples."@en ;
    sai:evidence "Escalation procedure"@en ,
        "Test results"@en .

sai:L4.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Urgent need is never queued behind review"@en ;
    skos:notation "L4.06" ;
    sai:level sai:L4 ;
    sai:question "Can a request involving urgent human need or danger skip any approval or review queue meant for routine content?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Give urgent-need items a priority path that reaches a person immediately."@en ,
        "2. Make it a rule that review of tone, mission, or policy never delays help."@en ;
    sai:evidence "Priority rule"@en ,
        "Test showing immediate routing"@en .

sai:L4.07
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "AI informs; people decide eligibility and priority"@en ;
    skos:notation "L4.07" ;
    sai:level sai:L4 ;
    sai:question "When AI contributes to decisions about aid, services, or care priority, is a named person always the decider, and is their decision recorded?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "People, not algorithms, decide who receives help."@en ;
    sai:step "1. List decisions that affect a person's access to help: eligibility, priority, referral, grants."@en ,
        "2. Require a named person to decide each, with the AI's contribution shown as input only."@en ,
        "3. Record the decision and the person who made it."@en ;
    sai:evidence "Decision records"@en .

sai:L4.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Fairness checks on AI rankings"@en ;
    skos:notation "L4.08" ;
    sai:level sai:L4 ;
    sai:question "Before AI rankings or recommendations are used (care queues, aid, outreach), do you check that they do not systematically disadvantage a group?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-high ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Choose the groups relevant to your work and the data you can lawfully use to check them."@en ,
        "2. Compare outcomes across groups on a sample before go-live, then periodically."@en ,
        "3. Document what you checked and what you changed."@en ;
    sai:evidence "Fairness check report"@en .

sai:L4.09
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "AI scores and classifications of people are visible"@en ;
    skos:notation "L4.09" ;
    sai:level sai:L4 ;
    sai:question "Is any AI-produced score, label, or classification of a person disclosed to staff and explainable to them?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "How the AI measures and ranks people is visible, not hidden."@en ;
    sai:step "1. Inventory every place an AI assigns a score, tag, risk level, or category to a person."@en ,
        "2. Show it to staff with the factors behind it."@en ,
        "3. Retire any that cannot be explained."@en ;
    sai:evidence "Inventory of AI classifications"@en ,
        "Screenshots of explanations"@en .

sai:L4.10
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "No appeals that exploit vulnerability"@en ;
    skos:notation "L4.10" ;
    sai:level sai:L4 ;
    sai:question "Is AI prevented from tailoring fundraising, engagement, or persuasion to exploit grief, crisis, age, or isolation?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. State in policy that AI-assisted appeals may not target vulnerability."@en ,
        "2. Add a review step for AI-drafted appeals, including the segments they target."@en ;
    sai:evidence "Policy text"@en ,
        "Review records"@en .

sai:L4.11
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "Protections are on by default and can only be raised"@en ;
    skos:notation "L4.11" ;
    sai:level sai:L4 ;
    sai:question "Do protections for vulnerable people ship enabled, and can an administrator only strengthen them, never weaken them?"@en ;
    sai:audience sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "Protecting the vulnerable is the provider's burden and cannot be weakened."@en ;
    sai:step "1. Ship the protected-persons rules switched on."@en ,
        "2. Make them non-waivable at the customer or chapter level. Allow tightening only."@en ,
        "3. Do not shift the burden of control onto the families or administrators who might not find the setting."@en ;
    sai:evidence "Default configuration"@en ,
        "Admin settings showing no weaken option"@en .

sai:L4.12
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "A person's worth is never scored by usefulness"@en ;
    skos:notation "L4.12" ;
    sai:level sai:L4 ;
    sai:question "Do you make sure that no AI score, ranking, or recommendation treats a person's worth or deservingness as depending on what they produce, achieve, or contribute (for example productivity, capacity, age, or ability)?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "A person's worth is never scored by what they produce."@en ;
    sai:step "1. List every AI score, ranking, or prioritization that applies to people."@en ,
        "2. Review each measure. Prioritizing by need is fine; treating output, ability, age, or usefulness as a person's worth is not. Remove or change any measure that does."@en ,
        "3. Require a named person to sign off on each measure, and re-review when the model or its inputs change."@en ;
    sai:evidence "List of AI scoring uses with review notes"@en ,
        "Sign-off record"@en .

sai:L5.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Mission and commitments are written down for AI"@en ;
    skos:notation "L5.01" ;
    sai:level sai:L5 ;
    sai:question "Have you written down your mission, firm commitments, and red lines in a form that an AI can be given and a person can audit?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Write a short values file: what you stand for, what you never do, and what is left to judgment."@en ,
        "2. For each commitment, say how firmly it is held (firm, flexible, or open)."@en ,
        "3. Have your leadership approve it."@en ;
    sai:evidence "Values file"@en ,
        "Approval record"@en .

sai:L5.02
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Values file is given to the AI as context"@en ;
    skos:notation "L5.02" ;
    sai:level sai:L5 ;
    sai:question "Is that values file loaded as context for the AI systems in scope?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Load the values file into the AI's instructions for each approved use case."@en ,
        "2. Be honest that this is guidance. The AI usually follows it, and nothing ensures it."@en ;
    sai:evidence "Configuration showing the loaded file"@en .

sai:L5.03
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Enforced commitments are separated from guidance"@en ;
    skos:notation "L5.03" ;
    sai:level sai:L5 ;
    sai:question "Can you show which of your commitments are enforced by a gate or a person, and which are guidance only?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Mark each commitment as enforced in code, enforced by a person, or guidance only."@en ,
        "2. Compile only firm commitments that a machine can check into rules. Flexible ones become at most a review flag, and open ones are never turned into rules."@en ,
        "3. Show the result to leadership and reviewers."@en ;
    sai:evidence "Enforced-versus-guided table"@en .

sai:L5.04
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Your values are authored by you"@en ;
    skos:notation "L5.04" ;
    sai:level sai:L5 ;
    sai:question "Were your values written and approved by your own governance, rather than supplied as a default by a vendor or developer?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Have your board or leadership adopt the values through your normal process."@en ,
        "2. If you build software, set floors only for safeguarding and data protection. Never ship values or doctrine as a default."@en ;
    sai:evidence "Adoption record"@en .

sai:L5.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Claims are sourced and estimates are marked"@en ;
    skos:notation "L5.05" ;
    sai:level sai:L5 ;
    sai:question "Must AI-drafted content that states facts or speaks for your organization cite sources and mark estimates, with unsourced claims flagged for a reviewer?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Require a source for factual claims and for statements about your own positions."@en ,
        "2. Mark estimates and uncertainty explicitly in drafts."@en ,
        "3. Hold, and do not block, content with unsourced claims, so a reviewer can decide."@en ;
    sai:evidence "Review checklist"@en ,
        "Examples of flagged drafts"@en .

sai:L5.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Open questions are marked as opinion"@en ;
    skos:notation "L5.06" ;
    sai:level sai:L5 ;
    sai:question "When a question is genuinely contested or your organization has no settled position, does the AI say so and mark its answer as opinion?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. List the questions where your organization deliberately holds no position."@en ,
        "2. Tell the AI to present them as open and to avoid taking sides in your name."@en ,
        "3. Do not block content for taking a side. Check only that it is marked as opinion."@en ;
    sai:evidence "List of open questions"@en ,
        "Sample outputs"@en .

sai:L5.07
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Behavioral regression tests"@en ;
    skos:notation "L5.07" ;
    sai:level sai:L5 ;
    sai:question "Do you run a repeatable set of test questions, seeded from your values and from known drift, whenever a model or prompt changes?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Write 20 to 50 test prompts that probe your red lines and the ways AI tends to drift from your values."@en ,
        "2. Record expected and unacceptable answers. Have a person judge the results."@en ,
        "3. Re-run on every model, prompt, or values-file change and keep the results."@en ;
    sai:evidence "Test set"@en ,
        "Dated test results"@en .

sai:L5.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Public-facing AI content is reviewed before release"@en ;
    skos:notation "L5.08" ;
    sai:level sai:L5 ;
    sai:question "Is AI-drafted content that goes out in your name (publications, appeals, donor communications, public statements) reviewed by a person before release?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Define which outputs count as public-facing."@en ,
        "2. Require a named reviewer's approval before release."@en ,
        "3. Track how often reviewers change or reject drafts."@en ;
    sai:evidence "Review log"@en .

sai:L5.09
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Corrections can come from below"@en ;
    skos:notation "L5.09" ;
    sai:level sai:L5 ;
    sai:question "Is there a channel for staff, chapters, or the community to challenge or propose changes to the AI's rules, rather than only inheriting them?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Publish how to suggest a change to the AI rules."@en ,
        "2. Review proposals on a schedule and record the outcome."@en ;
    sai:evidence "Proposal channel"@en ,
        "Record of decisions"@en .

sai:L5.10
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "The governing values source is pinned and versioned"@en ;
    skos:notation "L5.10" ;
    sai:level sai:L5 ;
    sai:question "Is the document that governs your AI's values and commitments kept at a fixed, dated version, and does changing it require a recorded decision by a named person?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Name the document or documents that govern what the AI is told about your values and commitments."@en ,
        "2. Give each a version number and date, and store it somewhere that tracks changes."@en ,
        "3. Require a named approver for any change, and record the date, the reason, and the approver."@en ,
        "4. Test the AI's behavior against a new version before it goes live (see L5.07)."@en ;
    sai:evidence "Versioned values document"@en ,
        "Change records with approver"@en .

sai:L6.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "No signing as a person without their approval"@en ;
    skos:notation "L6.01" ;
    sai:level sai:L6 ;
    sai:question "Is it impossible for the AI to send something signed as a named staff member, leader, or professional unless that person approved this specific message?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Check sender identity and signature block on every outbound message."@en ,
        "2. Hold messages that carry a person's name or signature without that person's approval of the specific message."@en ;
    sai:evidence "Send rule"@en ,
        "Test messages"@en .

sai:L6.02
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "AI is disclosed where it matters"@en ;
    skos:notation "L6.02" ;
    sai:level sai:L6 ;
    sai:question "Do public-facing chatbots identify themselves as AI, and is AI-drafted content labeled wherever your policy or the law requires?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:floorPrinciple "The AI never passes as a person."@en ;
    sai:step "1. Have every chatbot state at the start that it is an AI."@en ,
        "2. Add a configurable disclosure line or metadata to AI-assisted messages."@en ,
        "3. Check disclosure rules that apply to you (verify with legal advice)."@en ;
    sai:evidence "Chatbot opening message"@en ,
        "Message footers"@en .

sai:L6.03
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "No simulated care, friendship, or companionship"@en ;
    skos:notation "L6.03" ;
    sai:level sai:L6 ;
    sai:question "Do you avoid member-facing AI that simulates care or companionship, and are care messages sent and followed up by a named person?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:floorPrinciple "Simulated care is never presented as a real relationship."@en ;
    sai:step "1. State the rule: the AI drafts, and a person cares."@en ,
        "2. Require a human sender for care and support messages."@en ,
        "3. Pay special attention to isolated, grieving, and dependent people, who are most at risk of mistaking simulation for relationship."@en ;
    sai:evidence "Policy"@en ,
        "Care messaging workflow"@en .

sai:L6.04
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Roles that need a human route to one"@en ;
    skos:notation "L6.04" ;
    sai:level sai:L6 ;
    sai:question "Do requests for counseling, clinical, legal, or other professional judgment route to a qualified person rather than being answered by the AI?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. List roles in your organization that require a qualified human."@en ,
        "2. Detect requests for those roles and route them to a named person."@en ,
        "3. Tell the user plainly that a person will handle it."@en ;
    sai:evidence "Role list"@en ,
        "Routing rule"@en ,
        "Test results"@en .

sai:L6.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Confidential disclosures are never solicited or recorded by AI"@en ;
    skos:notation "L6.05" ;
    sai:level sai:L6 ;
    sai:question "Is AI prevented from soliciting, recording in records, or sending confidential or privileged disclosures (counseling, legal, medical, or similar)?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Define what counts as confidential or privileged in your work."@en ,
        "2. Add content rules on writes and sends that hold and route such content to a person."@en ;
    sai:evidence "Content rule"@en ,
        "Test results"@en .

sai:L6.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Positive scope: what the AI is for"@en ;
    skos:notation "L6.06" ;
    sai:level sai:L6 ;
    sai:question "Have you written down what the AI is for, so that a refusal can come with a helpful alternative?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. For each boundary, write what the AI can still legitimately help with."@en ,
        "2. Include these in the AI's instructions."@en ;
    sai:evidence "Scope statement"@en .

sai:L6.07
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Guarding against over-reliance"@en ;
    skos:notation "L6.07" ;
    sai:level sai:L6 ;
    sai:question "Do you monitor whether staff accept AI output without scrutiny, and take steps to keep human judgment strong?"@en ;
    sai:audience sai:audience-organization ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Track how often reviewers edit or reject AI drafts. A rate near zero is a warning sign."@en ,
        "2. Rotate reviewers and sample approved items for second review."@en ;
    sai:evidence "Edit and reject metrics"@en ,
        "Sampling records"@en .

sai:L6.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "A human is always reachable"@en ;
    skos:notation "L6.08" ;
    sai:level sai:L6 ;
    sai:question "Can anyone using a public-facing AI reach a person easily?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Put a visible way to reach a person in every AI interface."@en ,
        "2. Staff the channel, and measure response time."@en ;
    sai:evidence "Interface screenshots"@en ,
        "Response time metrics"@en .

sai:L7.01
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Named owner for AI"@en ;
    skos:notation "L7.01" ;
    sai:level sai:L7 ;
    sai:question "Is there a named executive owner for AI use, and a group or role that reviews it?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Name one accountable executive."@en ,
        "2. Set up a small review group (operations, programs, safeguarding, technology, and a board liaison)."@en ,
        "3. Report to the board or equivalent at least twice a year."@en ;
    sai:evidence "Role description"@en ,
        "Meeting minutes"@en .

sai:L7.02
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Approved AI use policy"@en ;
    skos:notation "L7.02" ;
    sai:level sai:L7 ;
    sai:question "Do you have a short AI use policy that leadership approved and staff received?"@en ;
    sai:audience sai:audience-organization ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Write a policy covering approved tools, forbidden uses, data rules, and where to ask questions."@en ,
        "2. Have leadership approve it, publish it, and cover it in onboarding."@en ;
    sai:evidence "Policy"@en ,
        "Acknowledgement records"@en .

sai:L7.03
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Register of AI systems and use cases"@en ;
    skos:notation "L7.03" ;
    sai:level sai:L7 ;
    sai:question "Do you keep a current list of AI systems and use cases, each with a risk rating?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. List every AI tool and use case, including features built into software you already use."@en ,
        "2. Rate each by what it touches (see L1.01) and what it can do (see L3)."@en ,
        "3. Review the list at least every six months."@en ;
    sai:evidence "AI register"@en .

sai:L7.04
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "Responsibility map"@en ;
    skos:notation "L7.04" ;
    sai:level sai:L7 ;
    sai:question "For each deployment, is it written down what the vendor, the software provider, and your organization each answer for?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:floorPrinciple "Someone identifiable answers for the AI at every stage."@en ;
    sai:step "1. For each AI deployment, write who is responsible for the model, the integration, the data, the configuration, and the decisions."@en ,
        "2. Share it with leadership and, where relevant, with the people affected."@en ;
    sai:evidence "Responsibility map"@en .

sai:L7.05
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Audit log of AI activity"@en ;
    skos:notation "L7.05" ;
    sai:level sai:L7 ;
    sai:question "Does a log record who used which AI tool, with what inputs and actions, and what the outcome was?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Log user, time, tool, parameters, and outcome for every AI action."@en ,
        "2. Protect the log from alteration, and limit who can read it."@en ,
        "3. Keep personal data out of the log where possible."@en ;
    sai:evidence "Sample log entries"@en ,
        "Log retention settings"@en .

sai:L7.06
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Log records authority, not only activity"@en ;
    skos:notation "L7.06" ;
    sai:level sai:L7 ;
    sai:question "Do your logs show who granted the permission, under which policy version, whether a person overrode a decision, and whether the AI escalated or delegated?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Add grant, signer, policy version, override, and escalation-or-delegation fields to the log schema."@en ,
        "2. Test that a reviewer can reconstruct why an action was allowed."@en ;
    sai:evidence "Log schema"@en ,
        "Reconstruction test"@en .

sai:L7.07
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Kill switch"@en ;
    skos:notation "L7.07" ;
    sai:level sai:L7 ;
    sai:question "Can an administrator switch AI access off immediately, for one user, one tool, or everything?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-critical ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Identify the single place where AI access can be cut off."@en ,
        "2. Name two people who can use it, and write down how."@en ,
        "3. Practice it once."@en ;
    sai:evidence "Runbook"@en ,
        "Test record"@en .

sai:L7.08
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "AI incident response"@en ;
    skos:notation "L7.08" ;
    sai:level sai:L7 ;
    sai:question "Do you have a plan for AI incidents (data exposure, harmful message, wrong action), including who is told and how you learn from it?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Add AI scenarios to your existing incident plan."@en ,
        "2. Define who decides, who is notified (including regulators, funders, and affected people where required), and how lessons are recorded."@en ,
        "3. Run a tabletop exercise once a year."@en ;
    sai:evidence "Incident plan"@en ,
        "Exercise notes"@en .

sai:L7.09
    a owl:NamedIndividual ,
        sai:FloorControl ;
    rdfs:label "Recourse for affected people"@en ;
    skos:notation "L7.09" ;
    sai:level sai:L7 ;
    sai:question "Can a person affected by an AI-informed decision ask for review by a human, and can staff reconstruct how the decision was reached?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-medium ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:floorPrinciple "Anyone affected can appeal to a human."@en ;
    sai:step "1. Tell affected people how to ask for a human review."@en ,
        "2. Make sure the log (see L7.05, L7.06) lets staff reconstruct the decision."@en ,
        "3. Record the outcome of each review."@en ;
    sai:evidence "Published recourse process"@en ,
        "Sample review record"@en .

sai:L7.10
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Impact assessment before higher-risk use"@en ;
    skos:notation "L7.10" ;
    sai:level sai:L7 ;
    sai:question "Before enabling write, send, or decision-support uses, do you complete a short assessment of impact on people, especially the most vulnerable?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Use a one-page checklist: who is affected, what could go wrong, what safeguards exist, who signs."@en ,
        "2. Include the voice of the people affected, or those who represent them."@en ,
        "3. Attach it to the grant record (see L3.05)."@en ;
    sai:evidence "Completed assessments"@en .

sai:L7.11
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Staff AI literacy"@en ;
    skos:notation "L7.11" ;
    sai:level sai:L7 ;
    sai:question "Have staff and volunteers who use AI been taught what it can and cannot do, and how to spot errors?"@en ;
    sai:audience sai:audience-organization ;
    sai:maxGuarantee sai:guided ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Run a short session (one hour) on hallucination, bias, privacy, and the limits of the AI."@en ,
        "2. Repeat for new staff, and refresh when tools change."@en ;
    sai:evidence "Training materials"@en ,
        "Attendance"@en .

sai:L7.12
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Claims discipline"@en ;
    skos:notation "L7.12" ;
    sai:level sai:L7 ;
    sai:question "Do you check that nothing you tell supporters, funders, or constituents about AI safety describes a guided control as if it were enforced?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Before publishing a safety claim, find the control behind it and check its guarantee type."@en ,
        "2. Say enforced only for structural controls. Say recommended or guided for the rest."@en ,
        "3. Do not describe roadmap items in the present tense."@en ;
    sai:evidence "Claims review record"@en .

sai:L7.13
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Red-team testing"@en ;
    skos:notation "L7.13" ;
    sai:level sai:L7 ;
    sai:question "Do you test your safeguards with deliberate attempts to break them, including instructions hidden in documents?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-high ;
    sai:effort sai:effort-high ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Seed known violations (a message to a minor, a hidden instruction in an upload, an attempt to read a blocked record)."@en ,
        "2. Confirm each is caught. Keep the results as a regression suite."@en ,
        "3. Re-run on every material change."@en ;
    sai:evidence "Red-team test set"@en ,
        "Results"@en .

sai:L7.14
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Change control and review rhythm"@en ;
    skos:notation "L7.14" ;
    sai:level sai:L7 ;
    sai:question "Are your AI policies versioned, and are they reviewed on a regular schedule and whenever something material changes?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:procedural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-low ;
    sai:quickWin "true"^^xsd:boolean ;
    sai:step "1. Give every policy and rule set a version number and date."@en ,
        "2. Review at least annually, and on any material change of model, vendor, or use."@en ,
        "3. Changes to firm commitments trigger re-testing and sign-off."@en ;
    sai:evidence "Version history"@en ,
        "Review minutes"@en .

sai:L7.15
    a owl:NamedIndividual ,
        sai:Control ;
    rdfs:label "Policy inheritance across chapters or affiliates"@en ;
    skos:notation "L7.15" ;
    sai:level sai:L7 ;
    sai:question "If you have chapters, affiliates, or customers, can a parent set rules that the others inherit and can tighten but not weaken?"@en ;
    sai:audience sai:audience-organization ,
        sai:audience-product ;
    sai:maxGuarantee sai:structural ;
    sai:severity sai:severity-medium ;
    sai:effort sai:effort-high ;
    sai:quickWin "false"^^xsd:boolean ;
    sai:step "1. Define which rules are set centrally and which are local."@en ,
        "2. Let local units tighten central rules, never loosen them."@en ,
        "3. Let local units propose changes to the center (see L5.09)."@en ;
    sai:evidence "Policy hierarchy"@en ,
        "Configuration"@en .

