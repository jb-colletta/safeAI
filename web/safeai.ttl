# ---- Classes

sai:Verb
    a owl:Class ;
    rdfs:label "Verb"@en ;
    skos:definition "One of the four groups the seven levels fall into: SEE, DO, SAY, ANSWER."@en .

sai:Level
    a owl:Class ;
    rdfs:label "Level"@en ;
    skos:definition "One of the seven levels of the question \"Is it safe?\"."@en .

sai:Control
    a owl:Class ;
    rdfs:label "Control"@en ;
    skos:definition "An individual, assessable safeguard within one level."@en .

sai:FloorControl
    a owl:Class ;
    rdfs:subClassOf sai:Control ;
    rdfs:label "Human-dignity floor control"@en ;
    skos:definition "A control in the human-dignity floor. It must be met at procedural or structural level, or the overall rating is held at Developing."@en .

sai:GuaranteeType
    a owl:Class ;
    rdfs:label "Guarantee type"@en ;
    skos:definition "How a control's protection is guaranteed: structural, procedural, guided, or none."@en .

sai:Audience
    a owl:Class ;
    rdfs:label "Audience"@en ;
    skos:definition "Who a control applies to: an organization that uses AI tools, or a product that builds AI features."@en .

sai:Severity
    a owl:Class ;
    rdfs:label "Severity"@en ;
    skos:definition "How bad a gap in a control is."@en .

sai:Effort
    a owl:Class ;
    rdfs:label "Effort"@en ;
    skos:definition "The rough cost of closing a gap in a control."@en .

